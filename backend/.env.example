# Copy this file to ".env" and fill in your real values. Never commit ".env".

# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Change this to a long random string in production
JWT_SECRET_KEY=change_this_to_a_long_random_secret_string

# SQLite file will be created automatically in the backend folder
DATABASE_URL=sqlite:///./sherlock.db

# Frontend origin allowed to call this API (Vite dev server)
FRONTEND_ORIGIN=http://localhost:5175
